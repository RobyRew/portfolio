---
import { Icon } from 'astro-icon/components';

/**
 * Accessible, URL-addressable tabs (WAI-ARIA tabs pattern).
 *
 * - Panels are passed as named slots matching each tab id.
 * - The active tab syncs to `location.hash` (#projects, #resume, …) so every
 *   tab is deep-linkable and survives reloads / sharing.
 * - Keyboard: ←/→/Home/End roving focus, Enter/Space select.
 * - No-JS: all panels render stacked (a <noscript> style unhides them).
 */
export interface Tab {
  id: string;
  label: string;
  icon: string;
}
export interface Props {
  tabs: Tab[];
  ariaLabel: string;
}
const { tabs, ariaLabel } = Astro.props;

const panels = await Promise.all(tabs.map((tab) => Astro.slots.render(tab.id)));
---

<div data-tabs>
  <div
    role="tablist"
    aria-label={ariaLabel}
    class="no-print -mx-1 flex gap-1 overflow-x-auto border-b border-[var(--line)] px-1"
  >
    {tabs.map((tab, i) => (
      <button
        type="button"
        role="tab"
        id={`tab-${tab.id}`}
        aria-controls={`panel-${tab.id}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        class="-mb-px flex shrink-0 cursor-pointer items-center gap-1.5 px-3.5 py-2.5 text-sm font-medium"
      >
        <Icon name={tab.icon} class="h-4 w-4" aria-hidden="true" />
        {tab.label}
      </button>
    ))}
  </div>

  {tabs.map((tab, i) => (
    <section
      role="tabpanel"
      id={`panel-${tab.id}`}
      aria-labelledby={`tab-${tab.id}`}
      tabindex="0"
      hidden={i !== 0}
      class="pt-6 outline-none sm:pt-8"
    >
      <h2 class="sr-only">{tab.label}</h2>
      <Fragment set:html={panels[i]} />
    </section>
  ))}
</div>

<!-- No-JS: unhide every panel so the page reads as one long document.
     `is:inline` keeps the style inside <noscript> — Astro would otherwise
     hoist it into the global bundle and apply it unconditionally. -->
<noscript>
  <style is:inline>
    [role='tabpanel'][hidden] { display: block !important; }
    [role='tablist'] { display: none !important; }
  </style>
</noscript>

<script>
  function initTabs(root: HTMLElement): void {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>(':scope > [role="tabpanel"]'));
    const ids = tabs.map((tab) => tab.id.replace(/^tab-/, ''));
    if (tabs.length === 0) return;

    function select(id: string, opts: { focus?: boolean; hash?: boolean } = {}): void {
      const index = ids.indexOf(id);
      if (index === -1) return;
      tabs.forEach((tab, i) => {
        const active = i === index;
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
        tab.tabIndex = active ? 0 : -1;
      });
      panels.forEach((panel, i) => {
        panel.hidden = i !== index;
      });
      if (opts.focus) tabs[index]?.focus();
      if (opts.hash) history.replaceState(null, '', `#${id}`);
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(ids[i] ?? '', { hash: true }));
      tab.addEventListener('keydown', (event) => {
        let target = -1;
        if (event.key === 'ArrowRight') target = (i + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') target = (i - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') target = 0;
        else if (event.key === 'End') target = tabs.length - 1;
        if (target === -1) return;
        event.preventDefault();
        select(ids[target] ?? '', { focus: true, hash: true });
      });
    });

    function fromHash(): void {
      const id = window.location.hash.slice(1);
      if (ids.includes(id)) select(id);
    }
    window.addEventListener('hashchange', fromHash);
    fromHash();
  }

  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach(initTabs);
</script>
