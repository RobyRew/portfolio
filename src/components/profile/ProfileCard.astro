---
import { Icon } from 'astro-icon/components';
import type { Locale } from '@i18n/utils';
import { t, localeIntl } from '@i18n/utils';
import { IDENTITY, SOCIALS } from '@config/site';

export interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const born = new Intl.DateTimeFormat(localeIntl(locale), {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date(IDENTITY.birthDate));

const facts = [
  { icon: 'lucide:briefcase', label: t(locale, 'profile.facts.roleLabel'), value: t(locale, 'profile.facts.role') },
  { icon: 'lucide:cake', label: t(locale, 'profile.facts.bornLabel'), value: born },
  { icon: 'lucide:map-pin', label: t(locale, 'profile.facts.locationLabel'), value: t(locale, 'profile.facts.location') },
  { icon: 'lucide:heart', label: t(locale, 'profile.facts.passionLabel'), value: t(locale, 'profile.facts.passion') },
] as const;
---

<section class="card p-5 sm:p-6" aria-label={t(locale, 'profile.cardAria')}>
  <p class="mb-5 text-base leading-relaxed text-[var(--fg)]">
    {t(locale, 'profile.bio')}
  </p>

  <dl class="mb-5 grid grid-cols-1 gap-x-6 gap-y-3 text-sm sm:grid-cols-2">
    {facts.map((fact) => (
      <div class="flex items-center gap-2.5">
        <Icon name={fact.icon} class="h-4 w-4 shrink-0 text-[var(--color-accent-600)] dark:text-[var(--color-accent-400)]" aria-hidden="true" />
        <dt class="sr-only">{fact.label}</dt>
        <dd class="text-[var(--fg-2)]">{fact.value}</dd>
      </div>
    ))}
  </dl>

  <div class="flex flex-wrap items-center gap-1" role="list" aria-label={t(locale, 'profile.socialsAria')}>
    {SOCIALS.map((social) => (
      <div class="tooltip-wrap" role="listitem">
        <a
          href={social.url}
          rel={social.url.startsWith('http') ? 'me noopener' : undefined}
          class="grid h-9 w-9 place-items-center rounded-md text-[var(--fg-2)] transition-colors hover:bg-[var(--bg-2)] hover:text-[var(--color-accent-600)] dark:hover:text-[var(--color-accent-400)]"
        >
          <Icon name={social.icon} class="h-5 w-5" aria-hidden="true" />
          <span class="sr-only">{social.label}</span>
        </a>
        <span class="tooltip" role="tooltip">
          <strong class="font-semibold text-[var(--fg)]">{social.label}</strong>: {social.username}
        </span>
      </div>
    ))}
  </div>
</section>
