---
import type { Locale } from '@i18n/utils';
import { t, path, alternateLinks } from '@i18n/utils';
import { Icon } from 'astro-icon/components';
import { FEATURES } from '@config/site';
import AppearanceMenu from '@islands/AppearanceMenu';
import LocaleSwitcher from '@islands/LocaleSwitcher';
import CommandPalette from '@islands/CommandPalette';

export interface Props {
  locale: Locale;
  currentPath: string;
}
const { locale, currentPath } = Astro.props;

// The site is a single profile page; nav entries deep-link into its tabs.
// On the profile page itself the Tabs script picks the hash change up
// without a reload; from subpages it navigates home first.
const nav = [
  { href: `${path(locale)}#projects`, key: 'tabs.projects' },
  { href: `${path(locale)}#resume`, key: 'tabs.resume' },
  { href: `${path(locale)}#skills`, key: 'tabs.skills' },
  ...(FEATURES.gallery ? [{ href: `${path(locale)}#gallery`, key: 'tabs.gallery' }] : []),
] as const;

const localeAlternates = alternateLinks(locale, currentPath);
const dict = {
  switchTheme: t(locale, 'actions.switchTheme'),
  themeLight: t(locale, 'actions.themeLight'),
  themeDark: t(locale, 'actions.themeDark'),
  themeSystem: t(locale, 'actions.themeSystem'),
  accent: t(locale, 'actions.accent'),
  switchLanguage: t(locale, 'actions.switchLanguage'),
  openMenu: t(locale, 'actions.openMenu'),
  commandPalette: t(locale, 'actions.commandPalette'),
};
const accentNames = {
  mint: t(locale, 'accents.mint'),
  blue: t(locale, 'accents.blue'),
  violet: t(locale, 'accents.violet'),
  amber: t(locale, 'accents.amber'),
};
---

<header class="sticky top-0 z-30 border-b border-[var(--line)] bg-[var(--bg)]/85 backdrop-blur-md no-print">
  <div class="mx-auto flex h-14 max-w-5xl items-center gap-2 px-4 sm:px-6 lg:px-8">
    <a href={path(locale)} class="group flex items-center gap-2 font-bold tracking-tight">
      <span class="grid h-7 w-7 place-items-center rounded-md bg-[var(--color-accent-500)] text-white">cc</span>
      <span class="hidden text-base text-[var(--fg)] sm:inline">Cosmin Calin</span>
    </a>

    <nav class="ml-2 hidden flex-1 items-center gap-1 sm:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          data-cmd
          data-cmd-label={t(locale, item.key)}
          data-cmd-group="navigate"
          class="rounded-md px-3 py-1.5 text-sm text-[var(--fg-2)] transition-colors hover:bg-[var(--bg-2)] hover:text-[var(--fg)]"
        >
          {t(locale, item.key)}
        </a>
      ))}
    </nav>

    <div class="ml-auto flex items-center gap-1">
      {FEATURES.commandPalette && (
        <CommandPalette client:idle locale={locale} triggerLabel={dict.commandPalette} />
      )}
      <LocaleSwitcher
        client:idle
        locale={locale}
        alternates={localeAlternates}
        label={dict.switchLanguage}
      />
      <AppearanceMenu
        client:idle
        labels={{
          toggle: dict.switchTheme,
          light: dict.themeLight,
          dark: dict.themeDark,
          system: dict.themeSystem,
          accent: dict.accent,
          accents: accentNames,
        }}
      />

      <!-- Mobile menu — uses a <details> for zero-JS fallback -->
      <details class="relative sm:hidden">
        <summary
          aria-label={dict.openMenu}
          class="grid h-9 w-9 cursor-pointer place-items-center rounded-md text-[var(--fg-2)] hover:bg-[var(--bg-2)] hover:text-[var(--fg)] [&::-webkit-details-marker]:hidden"
        >
          <Icon name="lucide:menu" class="h-5 w-5" />
        </summary>
        <div class="absolute right-0 top-[calc(100%+0.5rem)] w-48 origin-top-right rounded-lg border border-[var(--line)] bg-[var(--bg)] p-1 shadow-lg">
          {nav.map((item) => (
            <a
              href={item.href}
              class="block rounded-md px-3 py-2 text-sm text-[var(--fg-2)] transition-colors hover:bg-[var(--bg-2)] hover:text-[var(--fg)]"
            >
              {t(locale, item.key)}
            </a>
          ))}
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // Close the mobile <details> menu after choosing an entry — hash-only
  // navigation does not reload the page, so it would otherwise stay open.
  document.querySelectorAll<HTMLDetailsElement>('header details').forEach((details) => {
    details.querySelectorAll('a').forEach((link) =>
      link.addEventListener('click', () => details.removeAttribute('open')),
    );
  });
</script>
