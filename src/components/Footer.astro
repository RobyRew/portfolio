---
import type { Locale } from '@i18n/utils';
import { t, path } from '@i18n/utils';
import { Icon } from 'astro-icon/components';
import { SOCIALS } from '@config/site';

export interface Props { locale: Locale; }
const { locale } = Astro.props;
const year = new Date().getFullYear();

const github = SOCIALS.find((s) => s.id === 'github');
const linkedin = SOCIALS.find((s) => s.id === 'linkedin');
---

<!-- Floated like the bar, so the two read as one functional layer. -->
<div class="no-print px-4 pb-4 sm:px-6 lg:px-8">
  <footer class="rw-glass mx-auto max-w-5xl" style="--r:22px">
    <div class="flex flex-col gap-4 p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6">
    <p class="text-sm text-[var(--g-ink-dim)]">
      {t(locale, 'footer.themeBy', { year })}
    </p>

    <div class="flex flex-wrap items-center gap-4 text-sm">
      <a href={path(locale, 'cv')} class="text-[var(--g-ink-dim)] hover:text-[var(--g-ink)] hover:underline">
        {t(locale, 'nav.cv')}
      </a>
      {github && (
        <a href={github.url} rel="me noopener" class="flex items-center gap-1 text-[var(--g-ink-dim)] hover:text-[var(--g-ink)] hover:underline">
          <Icon name="simple-icons:github" class="h-4 w-4" /> GitHub
        </a>
      )}
      {linkedin && (
        <a href={linkedin.url} rel="me noopener" class="flex items-center gap-1 text-[var(--g-ink-dim)] hover:text-[var(--g-ink)] hover:underline">
          <Icon name="simple-icons:linkedin" class="h-4 w-4" /> LinkedIn
        </a>
      )}
      <a href="https://github.com/cosmincalin/portfolio" rel="noopener" class="text-[var(--g-ink-dim)] hover:text-[var(--g-ink)] hover:underline">
        {t(locale, 'footer.source')}
      </a>
    </div>
  </div>

  <div class="mx-auto flex max-w-5xl flex-col items-center gap-2 px-4 pb-6 sm:flex-row sm:justify-between sm:px-6 lg:px-8">
    <p class="text-xs text-[var(--fg-2)]">
      {t(locale, 'footer.builtWith')}
    </p>
    <div class="flex items-center gap-4 text-xs">
      <a href={path(locale, 'legal', 'terms')} class="text-[var(--g-ink-dim)] hover:text-[var(--g-ink)] hover:underline">
        {t(locale, 'legal.terms')}
      </a>
      <a href={path(locale, 'legal', 'privacy')} class="text-[var(--g-ink-dim)] hover:text-[var(--g-ink)] hover:underline">
        {t(locale, 'legal.privacy')}
      </a>
    </div>
  </div>
</footer>
</div>
