---
import { Icon } from 'astro-icon/components';

/**
 * The profile's tab switcher, rendered inside the floating glass bar.
 *
 * Before this the same four destinations existed three times over: as links in
 * the bar, as links in the mobile menu, and as the real tablist under the
 * profile card. The bar's links only set `location.hash` for the tablist to
 * pick up, so two of the three were decoration. This is the one control; the
 * panels live in TabPanels.astro and are matched by `group`.
 *
 * Shape is @robyrew/ui's .rw-seg — a recessed well inside the glass layer, not
 * a second glass surface on top of it, with one capsule that slides to the
 * selection. Only the bar-specific bits are styled here: the glass ink colours
 * (the well sits on glass, not on the page) and the compact icon-only mode.
 */
export interface Tab {
  id: string;
  label: string;
  icon: string;
}
export interface Props {
  tabs: Tab[];
  ariaLabel: string;
  group: string;
}
const { tabs, ariaLabel, group } = Astro.props;
---

<div
  class="rw-seg tb"
  role="tablist"
  aria-label={ariaLabel}
  data-tab-group={group}
  style={`--n:${tabs.length}`}
>
  <span class="rw-seg__thumb" aria-hidden="true"></span>
  {tabs.map((tab, i) => (
    <button
      type="button"
      role="tab"
      id={`tab-${group}-${tab.id}`}
      class="rw-seg__item tb__seg"
      aria-controls={`panel-${group}-${tab.id}`}
      aria-selected={i === 0 ? 'true' : 'false'}
      tabindex={i === 0 ? 0 : -1}
      data-tab={tab.id}
    >
      <Icon name={tab.icon} class="tb__icon" aria-hidden="true" />
      <span class="tb__label">{tab.label}</span>
    </button>
  ))}
</div>

<style>
  /* Layout inside the bar. The well itself, the thumb and the segment metrics
     all come from .rw-seg in @robyrew/ui. */
  .tb { flex: 1 1 auto; min-width: 0; }

  /* The well sits on the glass layer, so its labels take the glass ink ramp
     rather than the page ink ramp — the backdrop behind glass is not the page. */
  .tb__seg { color: var(--g-ink-dim); }
  .tb__seg:hover,
  .tb__seg[aria-selected='true'] { color: var(--g-ink); }

  .tb__icon { height: 1rem; width: 1rem; flex: none; }
  .tb__label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  /* Compact: icons only, so four segments plus the utilities still fit a
     375px bar without the labels truncating to nothing. */
  @media (max-width: 47.99em) {
    .tb__label {
      position: absolute;
      width: 1px; height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .tb__seg { padding-inline: .25rem; }
  }

  @media print { .tb { display: none; } }
</style>
