---
/** ⌘K palette as a native <dialog>. Replaces cmdk plus React: the browser
 *  already provides the modal, the top layer, focus trapping and Escape. */
interface Props { triggerLabel: string; placeholder?: string; emptyLabel?: string }
const { triggerLabel, placeholder = 'Search…', emptyLabel = 'No matches' } = Astro.props;
---
<button type="button" class="cp__open" data-cp-open aria-label={triggerLabel}>
  <span class="cp__glyph" aria-hidden="true">⌕</span>
  <span class="cp__hint">{triggerLabel}</span>
  <kbd class="cp__kbd">⌘K</kbd>
</button>

<dialog class="cp" data-cp aria-label={triggerLabel}>
  <div class="cp__field">
    <span aria-hidden="true">⌕</span>
    <input type="search" data-cp-input placeholder={placeholder} aria-label={placeholder}
           autocomplete="off" spellcheck="false" />
    <kbd class="cp__kbd">esc</kbd>
  </div>
  <ul class="cp__list" data-cp-list role="listbox" aria-label={triggerLabel}></ul>
  <p class="cp__empty" data-cp-empty hidden>{emptyLabel}</p>
</dialog>

<style>
  .cp__open {
    display: none; align-items: center; gap: .45rem; height: 2.25rem; padding: 0 .5rem 0 .7rem;
    border: 0; border-radius: 999px; cursor: pointer; font: inherit; font-size: .76rem;
    color: var(--g-ink-dim); background: rgb(var(--rim-rgb) / .1);
    box-shadow: inset 0 0 0 1px rgb(var(--rim-rgb) / .12); transition: color .16s, background .16s;
  }
  @media (min-width: 640px) { .cp__open { display: flex; } }
  .cp__open:hover { color: var(--g-ink); background: rgb(var(--rim-rgb) / .16); }
  .cp__open:focus-visible { outline: 2px solid var(--color-accent-500); outline-offset: 2px; }
  .cp__glyph { font-size: .9rem; }
  .cp__kbd {
    font-family: var(--font-mono); font-size: .6rem; padding: .2rem .35rem; border-radius: .35rem;
    color: var(--g-ink-mute); border: 1px solid rgb(var(--rim-rgb) / .18); background: none;
  }

  .cp {
    width: min(34rem, calc(100vw - 2rem)); padding: 0; border: 0; border-radius: 1.15rem;
    margin-top: 12vh; color: var(--fg);
    background: var(--bg); box-shadow: 0 30px 70px rgb(0 0 0 / .4), 0 0 0 1px var(--line);
  }
  .cp::backdrop { background: rgb(0 0 0 / .42); backdrop-filter: blur(3px); }
  .cp[open] { animation: cpIn .18s cubic-bezier(.32,.72,0,1); }
  @keyframes cpIn { from { opacity: 0; transform: scale(.97) translateY(-6px); } }

  .cp__field {
    display: flex; align-items: center; gap: .6rem; padding: .85rem 1rem;
    border-bottom: 1px solid var(--line); color: var(--fg-2);
  }
  .cp__field input {
    flex: 1; min-width: 0; border: 0; background: none; outline: none;
    font: inherit; font-size: .95rem; color: var(--fg);
  }
  .cp__field input::-webkit-search-cancel-button { display: none; }

  .cp__list { list-style: none; margin: 0; padding: .35rem; max-height: 22rem; overflow-y: auto; }
  .cp__list li { }
  .cp__row {
    display: flex; align-items: center; gap: .6rem; width: 100%; padding: .6rem .7rem;
    border: 0; border-radius: .8rem; background: none; cursor: pointer;
    font: inherit; font-size: .84rem; text-align: left; text-decoration: none; color: var(--fg-2);
  }
  .cp__row[aria-selected='true'], .cp__row:hover { background: var(--bg-2); color: var(--fg); }
  .cp__row .grp {
    margin-left: auto; font-family: var(--font-mono); font-size: .6rem;
    letter-spacing: .1em; text-transform: uppercase; color: var(--fg-2);
  }
  .cp__empty { margin: 0; padding: 1.4rem; text-align: center; font-size: .84rem; color: var(--fg-2); }
  @media (prefers-reduced-motion: reduce) { .cp[open] { animation: none; } }
</style>

<script>
  const root = document.querySelector<HTMLDialogElement>('[data-cp]');
  if (root) {
    // Aliased inside the guard so the non-null narrowing survives into the
    // hoisted function declarations below.
    const dlg = root;
    const input = dlg.querySelector<HTMLInputElement>('[data-cp-input]')!;
    const list = dlg.querySelector<HTMLUListElement>('[data-cp-list]')!;
    const empty = dlg.querySelector<HTMLElement>('[data-cp-empty]')!;
    let items: { label: string; href: string; group: string }[] = [];
    let idx = 0;

    // The page is the index: anything marked data-cmd is searchable, so adding a
    // link anywhere adds it here with no registry to keep in sync.
    function collect() {
      items = [...document.querySelectorAll<HTMLAnchorElement>('a[data-cmd]')].map((a) => ({
        label: a.dataset.cmdLabel || a.textContent!.trim(),
        href: a.getAttribute('href')!,
        group: a.dataset.cmdGroup || 'go',
      }));
    }

    function render(q: string) {
      const needle = q.trim().toLowerCase();
      const hits = needle ? items.filter((i) => i.label.toLowerCase().includes(needle)) : items;
      idx = 0;
      list.innerHTML = hits.map((i, n) =>
        `<li><a class="cp__row" role="option" href="${i.href}" aria-selected="${n === 0}">` +
        `<span>${i.label}</span><span class="grp">${i.group}</span></a></li>`).join('');
      empty.hidden = hits.length > 0;
    }

    function move(step: number) {
      const rows = [...list.querySelectorAll<HTMLAnchorElement>('.cp__row')];
      if (!rows.length) return;
      idx = (idx + step + rows.length) % rows.length;
      rows.forEach((r, n) => r.setAttribute('aria-selected', String(n === idx)));
      rows[idx]?.scrollIntoView({ block: 'nearest' });
    }

    function open() { collect(); render(''); dlg.showModal(); input.value = ''; input.focus(); }

    document.querySelectorAll('[data-cp-open]').forEach((b) => b.addEventListener('click', open));
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); open(); }
    });

    input.addEventListener('input', () => render(input.value));
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
      if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
      if (e.key === 'Enter') {
        const sel = list.querySelector<HTMLAnchorElement>('.cp__row[aria-selected="true"]');
        if (sel) { e.preventDefault(); location.href = sel.href; }
      }
    });
    // Click on the backdrop closes, matching every other modal on the platform.
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  }
</script>
