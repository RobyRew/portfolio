---
import type { Locale } from '@i18n/utils';
import { DEFAULT_LOCALE, LOCALES, t } from '@i18n/utils';
import { IDENTITY, SOCIALS, FEATURES } from '@config/site';
import BaseLayout from '@layouts/BaseLayout.astro';
import ProfileHeader from '@components/profile/ProfileHeader.astro';
import ProfileCard from '@components/profile/ProfileCard.astro';
import Tabs from '@components/profile/Tabs.astro';
import ProjectsPanel from '@components/profile/ProjectsPanel.astro';
import ResumePanel from '@components/profile/ResumePanel.astro';
import SkillsPanel from '@components/profile/SkillsPanel.astro';
import GalleryPanel from '@components/profile/GalleryPanel.astro';
import Lightbox from '@components/Lightbox.astro';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang: lang === DEFAULT_LOCALE ? undefined : lang } }));
}

const lang = (Astro.params.lang ?? DEFAULT_LOCALE) as Locale;

const tabs = [
  { id: 'projects', label: t(lang, 'tabs.projects'), icon: 'lucide:layout-grid' },
  { id: 'resume', label: t(lang, 'tabs.resume'), icon: 'lucide:file-text' },
  { id: 'skills', label: t(lang, 'tabs.skills'), icon: 'lucide:users' },
  ...(FEATURES.gallery
    ? [{ id: 'gallery', label: t(lang, 'tabs.gallery'), icon: 'lucide:image' }]
    : []),
];

// JSON-LD Person — machine-readable profile for search engines.
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: IDENTITY.name,
  jobTitle: IDENTITY.jobTitle,
  worksFor: { '@type': 'Organization', name: IDENTITY.employer },
  email: `mailto:${IDENTITY.email}`,
  url: Astro.site?.toString(),
  sameAs: SOCIALS.filter((s) => s.url.startsWith('http')).map((s) => s.url),
});
---

<BaseLayout locale={lang}>
  <ProfileHeader slot="hero" locale={lang} />

  <script type="application/ld+json" set:html={jsonLd} is:inline />

  <div class="space-y-8">
    <ProfileCard locale={lang} />

    <Tabs tabs={tabs} ariaLabel={t(lang, 'tabs.ariaLabel')}>
      <ProjectsPanel slot="projects" locale={lang} />
      <ResumePanel slot="resume" locale={lang} />
      <SkillsPanel slot="skills" locale={lang} />
      {FEATURES.gallery && <GalleryPanel slot="gallery" locale={lang} />}
    </Tabs>
  </div>

  <Lightbox locale={lang} />
</BaseLayout>
