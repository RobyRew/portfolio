---
import { DEFAULT_LOCALE, LOCALES } from '@i18n/utils';
import type { Locale } from '@i18n/utils';
import '@robyrew/ui/tokens.css';
import GlassBar from '@robyrew/ui/components/GlassBar.astro';
import GlassTile from '@robyrew/ui/components/GlassTile.astro';
import GlassList from '@robyrew/ui/components/GlassList.astro';
import GlassToast from '@robyrew/ui/components/GlassToast.astro';
import GlassFooter from '@robyrew/ui/components/GlassFooter.astro';
export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang: lang === DEFAULT_LOCALE ? undefined : lang } }));
}
const lang = (Astro.params.lang ?? DEFAULT_LOCALE) as Locale;
---
<html lang={lang}><head><meta charset="utf-8" /><title>ui test</title></head>
<body class="rw-bp-aurora">
  <GlassBar links={[{ label: 'Work', href: '/', current: true }, { label: 'Notes', href: '/n' }]}
            action={{ label: 'Contact', href: '/#c' }} hint="⌘K" />
  <GlassTile label="Visitors · 7d" value="1 284" delta="18.4%" spark={[38,52,44,66,58,79,94]} />
  <GlassList rows={[{ glyph: '⏻', label: 'Exit node', value: 'On', href: '/x' },
                    { glyph: '⌁', label: 'DNS filtering', value: 'Kids', href: '/y' }]} />
  <GlassToast title="Deployed." detail="portfolio · 15s" action={{ label: 'View log', href: '/l' }} />
  <GlassFooter groups={[{ title: 'Sites', links: [{ label: 'MapSwitch', href: 'https://maps.robyrew.com' }] }]}
               note="Apache-2.0" />
</body></html>
