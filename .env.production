# Committed on purpose. These are PUBLIC identifiers — Astro bakes every
# PUBLIC_* var into the shipped HTML, so they are visible to any visitor and are
# not secrets. They live here rather than in Dokploy's build-args UI because
# invisible deployment state is exactly how analytics stayed silently broken from
# 2026-06-26 to 2026-09-04: .env is gitignored, so the build had no website id and
# BaseLayout's `{umamiSrc && umamiId && ...}` guard never emitted the script.
#
# Forks: the script tag carries data-domains, so a deployment on any other
# hostname reports NOTHING. Change PUBLIC_UMAMI_DOMAINS + the id to use your own.
PUBLIC_UMAMI_SCRIPT_URL=https://stats.cosmincalin.es/script.js
PUBLIC_UMAMI_WEBSITE_ID=0f156db0-b5ab-478c-852f-2fb8e7f582e1
PUBLIC_UMAMI_DOMAINS=cosmincalin.es
