# ── Analytics (optional) ────────────────────────────────────────────
# Self-hosted Umami. Leave unset to build without analytics.
PUBLIC_UMAMI_SCRIPT_URL=https://stats.cosmincalin.es/script.js
PUBLIC_UMAMI_WEBSITE_ID=

# ── Auth (dormant — see src/lib/auth/README.md) ─────────────────────
# 'none' (default) keeps the site fully static and public.
# Setting 'logto' requires output:'server' + the Logto adapter; the build
# fails loudly if flipped before the adapter is implemented.
PUBLIC_AUTH_PROVIDER=none
#LOGTO_ENDPOINT=https://auth.robyrew.com
#LOGTO_APP_ID=
#LOGTO_APP_SECRET=
#LOGTO_COOKIE_SECRET=
