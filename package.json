{
  "name": "portfolio",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "description": "Personal portfolio — cosmincalin.es",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "start": "astro dev",
    "build": "npm run check && astro build",
