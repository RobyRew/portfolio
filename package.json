    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.10",
    "astro-icon": "^1.2.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/language-server": "^2.17.3",
    "@iconify-json/lucide": "^1.2.153",
    "@iconify-json/simple-icons": "^1.2.102",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "typescript-6": "npm:typescript@^6.0.3"
  },
  "engines": {
    "node": ">=26"
